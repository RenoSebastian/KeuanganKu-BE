# =========================================================
# APPLICATION CONFIGURATION
# =========================================================

# Environment Mode (development | production)
NODE_ENV="development"

# Server Port
PORT=4000

# Frontend URL (Untuk konfigurasi CORS di main.ts nanti)
FRONTEND_URL="http://localhost:3000"

# =========================================================
# DATABASE CONNECTION (PRISMA)
# =========================================================

# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
# Password '123' disesuaikan dengan settingan lokal/docker Anda.
DATABASE_URL="postgresql://postgres:123@localhost:5432/keuanganku_db?schema=public"

# =========================================================
# AUTHENTICATION & SECURITY
# =========================================================

# JWT Secret (Kunci Rahasia Token - Digunakan oleh JwtStrategy)
JWT_SECRET="rahasia_negara_pam_jaya_2025_secure_key"

# Durasi Token (1d = 1 hari, 1h = 1 jam, 60s = 60 detik)
JWT_EXPIRATION="1d"

# =========================================================
# OPTIONAL CONFIGURATION (Future Proofing)
# =========================================================

# Jika nanti pakai S3 untuk Media Storage (Fase 4 - Future)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_BUCKET_NAME=""