// File: prisma/schema.prisma

// =========================================================
// KONFIGURASI DATABASE
// =========================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "interactiveTransactions"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm] // Extension untuk pencarian teks cepat
}

// =========================================================
// ENUMS
// =========================================================

enum Role {
  USER
  ADMIN
  // DIRECTOR [DELETED - LEGACY CLEANUP]
}

enum HealthStatus {
  SEHAT
  WASPADA
  BAHAYA
}

enum EducationMethod {
  ARITHMETIC
  GEOMETRIC
}

enum SchoolLevel {
  TK
  SD
  SMP
  SMA
  S1
  S2
}

enum CostType {
  ENTRY
  ANNUAL
}

enum InsuranceType {
  LIFE
  HEALTH
  CRITICAL_ILLNESS
}

enum EducationModuleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EducationProgressStatus {
  STARTED
  COMPLETED
}

enum EducationLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum QuizQuestionType {
  SINGLE_CHOICE
}

enum VerificationStatus {
  PENDING
  VALID
  INVALID
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  REVOKED
  GRACE_PERIOD // [NEW] Status khusus masa tenggang
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum NotificationCategory {
  SUBSCRIPTION
  QUOTA
  SYSTEM
  PAYMENT
}

// Enum untuk tipe transaksi ledger kuota
enum QuotaTransactionType {
  SUBSCRIPTION_RENEWAL // Dapat dari paket langganan
  ADMIN_BONUS          // Ditambah manual oleh admin
  USAGE_SIMULATION     // Dipakai untuk generate PDF
  COMPENSATION         // Ganti rugi error
  CORRECTION           // Penyesuaian audit
  SYSTEM_DOWNGRADE     // [NEW] Reset kuota saat expired
}

// =========================================================
// MASTER DATA & CONFIGURATION (THE FOUNDATION)
// =========================================================

// [REFACTORED] Menggantikan 'UnitKerja' menjadi 'Agency' untuk konteks Asuransi
model Agency {
  id        String   @id @default(uuid())
  code      String   @unique @map("agency_code") // Ex: AG-001
  name      String   @map("agency_name")         // Ex: "Agency Jakarta Selatan"
  address   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("agencies")
}

// [NEW] Central Bank Logic - Konfigurasi Global Ekonomi (Dinamis)
// Tabel ini hanya akan memiliki 1 baris data (Singleton)
model GlobalMarketSettings {
  id            String   @id @default(uuid())
  inflationRate Decimal  @default(5.0) @map("inflation_rate") @db.Decimal(5, 2)   // Persentase (5.0 = 5%)
  interestRate  Decimal  @default(4.5) @map("interest_rate") @db.Decimal(5, 2)    // Suku Bunga Acuan (BI Rate)
  riskFreeRate  Decimal  @default(6.0) @map("risk_free_rate") @db.Decimal(5, 2)   // Return Obligasi Negara
  goldPrice     Decimal  @default(1000000) @map("gold_price") @db.Decimal(15, 2)  // Harga Emas Acuan (Manual Override)
  
  updatedAt     DateTime @updatedAt @map("updated_at")
  updatedBy     String?  @map("updated_by") // Admin ID yang terakhir mengubah

  @@map("global_market_settings")
}

// =========================================================
// USER MANAGEMENT
// =========================================================

model User {
  id               String  @id @default(uuid())
  agencyId         String? @map("agency_id")
  nip              String? @unique // Bisa digunakan sebagai Agent ID
  email            String  @unique
  passwordHash     String  @map("password_hash")
  fullName         String  @map("full_name")
  
  gender           String?   @db.VarChar(50)
  address          String?   @db.Text
  agentLevel       String?   @map("agent_level") // Junior, Senior, MDRT
  companyName      String?   @map("company_name") // Untuk Agen Independen
  goals            String?   @db.Text
  avatar           String?   @db.Text
  dateOfBirth      DateTime? @map("date_of_birth")
  dependentCount   Int       @default(0) @map("dependent_count")
  
  // Quota dikelola via UserQuotaLedger, field ini sebagai Cache/Snapshot
  quota            Int       @default(0) 

  role             Role      @default(USER)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at") // [NEW] Soft Delete

  agency               Agency?              @relation(fields: [agencyId], references: [id])
  
  budgetPlans          BudgetPlan[]
  financialChecks      FinancialCheckup[]
  eduPlans             EducationPlan[]
  pensionPlans         PensionPlan[]
  insurancePlans       InsurancePlan[]
  goalPlans            GoalPlan[]
  
  educationProgress    UserEducationProgress[]
  
  // Audit Relations
  actionsPerformed     AccessLog[]          @relation("ActorRelation")
  actionsTargeted      AccessLog[]          @relation("TargetRelation")
  adminActivities      AdminActivityLog[]   @relation("AdminActor")
  RetentionLog         RetentionLog[]
  simulationLogs       SimulationLog[]
  
  // Subscription & Usage Relations
  subscription         UserSubscription?
  subscriptionOrders   SubscriptionOrder[]
  notifications        Notification[]
  usage                UserUsage?
  quotaLedger          UserQuotaLedger[]
  activeSessions       ActiveSession[]

  @@index([agencyId])
  @@index([email])
  @@index([deletedAt]) // Index untuk optimasi filter soft delete
  @@map("users")
}

// =========================================================
// USAGE & SUBSCRIPTION SYSTEM (REVENUE ENGINE)
// =========================================================

model UserUsage {
  userId          String   @id @map("user_id")
  simulationQuota Int      @default(3) @map("simulation_quota") // Legacy field support
  totalUsed       Int      @default(0) @map("total_used")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_usages")
}

// Ledger untuk mencatat riwayat keluar-masuk kuota (Double-Entry)
model UserQuotaLedger {
  id           String               @id @default(uuid())
  userId       String               @map("user_id")
  amount       Int                  // Positif (Debit) atau Negatif (Kredit)
  type         QuotaTransactionType
  referenceId  String?              @map("reference_id") // ID Order atau ID Simulasi
  balanceAfter Int                  @map("balance_after") // Saldo setelah transaksi
  description  String?              @db.Text
  createdAt    DateTime             @default(now()) @map("created_at")
  deletedAt    DateTime?            @map("deleted_at") // [NEW] Soft Delete (Rarely used but safe)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("user_quota_ledgers")
}

model SubscriptionPlan {
  id             String   @id @default(uuid())
  code           String   @unique
  name           String
  description    String?  @db.Text
  durationMonths Int
  price          Decimal  @db.Decimal(15, 2)
  bonusQuota     Int      @default(0) @map("bonus_quota") // Kuota gratis saat beli paket
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  orders         SubscriptionOrder[]
  subscriptions  UserSubscription[]

  @@map("subscription_plans")
}

model SubscriptionOrder {
  id                 String             @id @default(uuid())
  userId             String             @map("user_id")
  planId             String             @map("plan_id")
  proofImageUrl      String             @map("proof_image_url")
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  adminNotes         String?            @map("admin_notes") @db.Text
  snapshotPrice      Decimal            @map("snapshot_price") @db.Decimal(15, 2)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at") // [NEW] Soft Delete

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan                  SubscriptionPlan       @relation(fields: [planId], references: [id])
  activatedSubscription UserSubscription[]
  paymentAudit          SubscriptionPaymentAudit?

  @@index([userId])
  @@index([verificationStatus])
  @@map("subscription_orders")
}

// Audit khusus verifikasi pembayaran (Anti-Fraud Internal)
model SubscriptionPaymentAudit {
  id               String             @id @default(uuid())
  orderId          String             @unique @map("order_id")
  adminId          String             @map("admin_id")
  status           VerificationStatus
  rejectionReason  String?            @map("rejection_reason") @db.Text
  proofSnapshotUrl String?            @map("proof_snapshot_url") // Snapshot bukti saat diverifikasi
  verifiedAt       DateTime           @default(now()) @map("verified_at")

  order SubscriptionOrder @relation(fields: [orderId], references: [id])
  
  @@map("subscription_payment_audits")
}

model UserSubscription {
  id                 String             @id @default(uuid())
  userId             String             @unique @map("user_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(ACTIVE)
  startDate          DateTime           @default(now()) @map("start_date")
  endDate            DateTime           @map("end_date")
  gracePeriodEndDate DateTime?          @map("grace_period_end_date") // [NEW] Buffer Time (Netflix Style)
  lastOrderId        String             @map("last_order_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      SubscriptionPlan  @relation(fields: [planId], references: [id])
  lastOrder SubscriptionOrder @relation(fields: [lastOrderId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([endDate])
  @@map("user_subscriptions")
}

// =========================================================
// NOTIFICATION & MONITORING SYSTEM
// =========================================================

model Notification {
  id        String               @id @default(uuid())
  userId    String               @map("user_id")
  type      NotificationType     @default(INFO)
  category  NotificationCategory @default(SYSTEM)
  title     String
  message   String               @db.Text
  isRead    Boolean              @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime             @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

// Untuk fitur Live Monitoring user yang sedang online (SINGLE CONCURRENT SESSION)
model ActiveSession {
  id               String   @id @default(uuid())
  sessionId        String   @unique @map("session_id") // ID JWT hybrid
  deviceId         String   @map("device_id")          // AppMySite/Browser Fingerprint (X-Device-ID)
  userId           String   @map("user_id")
  socketId         String?  @map("socket_id")          // Websocket koneksi aktif
  deviceInfo       String?  @map("device_info")        // User-Agent (Opsional untuk log)
  ipAddress        String?  @map("ip_address")
  refreshTokenHash String?  @map("refresh_token_hash") // Fallback rekonsiliasi Redis downtime
  lastActivityAt   DateTime @default(now()) @map("last_activity_at")
  loginAt          DateTime @default(now()) @map("login_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([lastActivityAt])
  @@map("active_sessions")
}

// Log aktivitas simulasi user (History Penggunaan)
model SimulationLog {
  id               String          @id @default(uuid())
  agentId          String          @map("agent_id")
  clientName       String          @map("client_name")
  clientAge        Int?            @map("client_age")
  clientCity       String?         @map("client_city")
  clientJob        String?         @map("client_job")
  inputPayload     Json            @map("input_payload")
  outputResult     Json?           @map("output_result")
  sessionId        String          @map("session_id")
  totalIncome      Decimal?        @map("total_income") @db.Decimal(15, 2)
  calculatedSurplus Decimal?       @map("calculated_surplus") @db.Decimal(15, 2)
  healthScore      Int?            @map("health_score")
  status           HealthStatus?   @default(BAHAYA)
  financialRatios  Json?           @map("financial_ratios")
  moduleType       String          @default("BUDGETING") @map("module_type")
  simulationDate   DateTime        @default(now()) @map("simulation_date")
  createdAt        DateTime        @default(now()) @map("created_at")

  agent User @relation(fields: [agentId], references: [id])

  @@index([agentId, sessionId])
  @@index([clientCity, clientJob])
  @@index([createdAt])
  @@map("simulation_logs")
}

// General Access Log (Untuk User Activity biasa)
model AccessLog {
  id           String   @id @default(uuid())
  actorId      String   @map("actor_id")
  targetUserId String?  @map("target_user_id")
  action       String   
  metadata     Json?    
  accessedAt   DateTime @default(now()) @map("accessed_at")

  actor      User  @relation("ActorRelation", fields: [actorId], references: [id])
  targetUser User? @relation("TargetRelation", fields: [targetUserId], references: [id])

  @@map("access_logs")
}

// [NEW] Admin Activity Log (Untuk Audit Konfigurasi & Aksi Sensitif Admin)
model AdminActivityLog {
  id         String   @id @default(uuid())
  adminId    String   @map("admin_id")
  actionType String   @map("action_type") // Ex: UPDATE_MARKET_SETTINGS, BAN_USER
  entityName String   @map("entity_name") // Ex: GlobalMarketSettings, User
  entityId   String?  @map("entity_id")
  changes    Json     @map("changes")     // { before: ..., after: ... }
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  admin      User     @relation("AdminActor", fields: [adminId], references: [id])

  @@map("admin_activity_logs")
}

model RetentionLog {
  id             String    @id @default(uuid())
  executorId     String    @map("executor_id")
  entityType     String    @map("entity_type")
  status         String    @default("STARTED")
  recordsDeleted Int       @default(0) @map("records_deleted")
  cutoffDate     DateTime  @map("cutoff_date")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  metadata       Json?
  executor       User      @relation(fields: [executorId], references: [id])

  @@index([startedAt])
  @@map("retention_logs")
}

// =========================================================
// FINANCIAL MODELS (LEGACY SUPPORTED)
// =========================================================

model BudgetPlan {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  month           Int
  year            Int
  fixedIncome     Decimal  @map("fixed_income") @db.Decimal(15, 2)
  variableIncome  Decimal  @default(0) @map("variable_income") @db.Decimal(15, 2)
  productiveDebt  Decimal  @default(0) @map("productive_debt") @db.Decimal(15, 2)
  consumptiveDebt Decimal  @default(0) @map("consumptive_debt") @db.Decimal(15, 2)
  insurance       Decimal  @default(0) @map("insurance") @db.Decimal(15, 2)
  saving          Decimal  @default(0) @map("saving") @db.Decimal(15, 2)
  livingCost      Decimal  @default(0) @map("living_cost") @db.Decimal(15, 2)
  totalIncome     Decimal  @map("total_income") @db.Decimal(15, 2)
  totalExpense    Decimal  @map("total_expense") @db.Decimal(15, 2)
  balance         Decimal  @map("balance") @db.Decimal(15, 2)
  status          String
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id])

  @@map("budget_plans")
}

model FinancialCheckup {
  id                          String       @id @default(uuid())
  userId                      String       @map("user_id")
  checkDate                   DateTime     @default(now()) @map("check_date")
  createdAt                   DateTime     @default(now()) @map("created_at")
  updatedAt                   DateTime     @updatedAt @map("updated_at")
  userProfile                 Json         @map("user_profile")
  spouseProfile               Json?        @map("spouse_profile")
  assetCash                   Decimal      @default(0) @map("asset_cash") @db.Decimal(15, 2)
  assetHome                   Decimal      @default(0) @map("asset_home") @db.Decimal(15, 2)
  assetVehicle                Decimal      @default(0) @map("asset_vehicle") @db.Decimal(15, 2)
  assetJewelry                Decimal      @default(0) @map("asset_jewelry") @db.Decimal(15, 2)
  assetAntique                Decimal      @default(0) @map("asset_antique") @db.Decimal(15, 2)
  assetPersonalOther          Decimal      @default(0) @map("asset_personal_other") @db.Decimal(15, 2)
  assetInvHome                Decimal      @default(0) @map("asset_inv_home") @db.Decimal(15, 2)
  assetInvVehicle             Decimal      @default(0) @map("asset_inv_vehicle") @db.Decimal(15, 2)
  assetGold                   Decimal      @default(0) @map("asset_gold") @db.Decimal(15, 2)
  assetInvAntique             Decimal      @default(0) @map("asset_inv_antique") @db.Decimal(15, 2)
  assetStocks                 Decimal      @default(0) @map("asset_stocks") @db.Decimal(15, 2)
  assetMutualFund             Decimal      @default(0) @map("asset_mutual_fund") @db.Decimal(15, 2)
  assetBonds                  Decimal      @default(0) @map("asset_bonds") @db.Decimal(15, 2)
  assetDeposit                Decimal      @default(0) @map("asset_deposit") @db.Decimal(15, 2)
  assetInvOther               Decimal      @default(0) @map("asset_inv_other") @db.Decimal(15, 2)
  debtKPR                     Decimal      @default(0) @map("debt_kpr") @db.Decimal(15, 2)
  debtKPM                     Decimal      @default(0) @map("debt_kpm") @db.Decimal(15, 2)
  debtCC                      Decimal      @default(0) @map("debt_cc") @db.Decimal(15, 2)
  debtCoop                    Decimal      @default(0) @map("debt_coop") @db.Decimal(15, 2)
  debtConsumptiveOther        Decimal      @default(0) @map("debt_consumptive_other") @db.Decimal(15, 2)
  debtBusiness                Decimal      @default(0) @map("debt_business") @db.Decimal(15, 2)
  incomeFixed                 Decimal      @default(0) @map("income_fixed") @db.Decimal(15, 2)
  incomeVariable              Decimal      @default(0) @map("income_variable") @db.Decimal(15, 2)
  installmentKPR              Decimal      @default(0) @map("installment_kpr") @db.Decimal(15, 2)
  installmentKPM              Decimal      @default(0) @map("installment_kpm") @db.Decimal(15, 2)
  installmentCC               Decimal      @default(0) @map("installment_cc") @db.Decimal(15, 2)
  installmentCoop             Decimal      @default(0) @map("installment_coop") @db.Decimal(15, 2)
  installmentConsumptiveOther Decimal      @default(0) @map("installment_consumptive_other") @db.Decimal(15, 2)
  installmentBusiness         Decimal      @default(0) @map("installment_business") @db.Decimal(15, 2)
  insuranceLife               Decimal      @default(0) @map("insurance_life") @db.Decimal(15, 2)
  insuranceHealth             Decimal      @default(0) @map("insurance_health") @db.Decimal(15, 2)
  insuranceHome               Decimal      @default(0) @map("insurance_home") @db.Decimal(15, 2)
  insuranceVehicle            Decimal      @default(0) @map("insurance_vehicle") @db.Decimal(15, 2)
  insuranceBPJS               Decimal      @default(0) @map("insurance_bpjs") @db.Decimal(15, 2)
  insuranceOther              Decimal      @default(0) @map("insurance_other") @db.Decimal(15, 2)
  savingEducation             Decimal      @default(0) @map("saving_education") @db.Decimal(15, 2)
  savingRetirement            Decimal      @default(0) @map("saving_retirement") @db.Decimal(15, 2)
  savingPilgrimage            Decimal      @default(0) @map("saving_pilgrimage") @db.Decimal(15, 2)
  savingHoliday               Decimal      @default(0) @map("saving_holiday") @db.Decimal(15, 2)
  savingEmergency             Decimal      @default(0) @map("saving_emergency") @db.Decimal(15, 2)
  savingOther                 Decimal      @default(0) @map("saving_other") @db.Decimal(15, 2)
  expenseFood                 Decimal      @default(0) @map("expense_food") @db.Decimal(15, 2)
  expenseSchool               Decimal      @default(0) @map("expense_school") @db.Decimal(15, 2)
  expenseTransport            Decimal      @default(0) @map("expense_transport") @db.Decimal(15, 2)
  expenseCommunication        Decimal      @default(0) @map("expense_communication") @db.Decimal(15, 2)
  expenseHelpers              Decimal      @default(0) @map("expense_helpers") @db.Decimal(15, 2)
  expenseTax                  Decimal      @default(0) @map("expense_tax") @db.Decimal(15, 2)
  expenseLifestyle            Decimal      @default(0) @map("expense_lifestyle") @db.Decimal(15, 2)
  expenseOther                Decimal      @default(0) @map("expense_other") @db.Decimal(15, 2)
  totalNetWorth               Decimal      @default(0) @map("total_net_worth") @db.Decimal(15, 2)
  surplusDeficit              Decimal      @default(0) @map("surplus_deficit") @db.Decimal(15, 2)
  healthScore                 Int          @default(0) @map("health_score")
  status                      HealthStatus @default(BAHAYA)
  ratiosDetails               Json         @map("ratios_details")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, checkDate(sort: Desc)])
  @@index([status])
  @@map("financial_checkups")
}

model EducationPlan {
  id           String          @id @default(uuid())
  userId       String          @map("user_id")
  childName    String          @map("child_name")
  childDob     DateTime        @map("child_dob")
  inflationRate Decimal         @default(10.0) @map("inflation_rate") @db.Decimal(5, 2)
  returnRate   Decimal         @default(12.0) @map("return_rate") @db.Decimal(5, 2)
  method       EducationMethod @default(GEOMETRIC)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  user         User            @relation(fields: [userId], references: [id])
  stages       EducationStage[]

  @@map("education_plans")
}

model EducationStage {
  id           String        @id @default(uuid())
  planId       String        @map("plan_id")
  level        SchoolLevel
  costType     CostType      @map("cost_type")
  currentCost  Decimal       @map("current_cost") @db.Decimal(15, 2)
  futureCost   Decimal       @map("future_cost") @db.Decimal(15, 2)
  yearsToStart Int           @map("years_to_start")
  monthlySaving Decimal       @map("monthly_saving") @db.Decimal(15, 2)
  plan         EducationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("education_stages")
}

model PensionPlan {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  currentAge      Int      @map("current_age")
  retirementAge   Int      @map("retirement_age")
  lifeExpectancy  Int      @default(80) @map("life_expectancy")
  currentExpense  Decimal  @map("current_expense") @db.Decimal(15, 2)
  currentSaving   Decimal  @default(0) @map("current_saving") @db.Decimal(15, 2)
  inflationRate   Decimal  @default(5.0) @map("inflation_rate") @db.Decimal(5, 2)
  returnRate      Decimal  @default(8.0) @map("return_rate") @db.Decimal(5, 2)
  totalFundNeeded Decimal  @map("total_fund_needed") @db.Decimal(15, 2)
  monthlySaving   Decimal  @map("monthly_saving") @db.Decimal(15, 2)
  user            User     @relation(fields: [userId], references: [id])

  @@map("pension_plans")
}

model InsurancePlan {
  id                 String        @id @default(uuid())
  userId             String        @map("user_id")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  type               InsuranceType @default(LIFE)
  dependentCount     Int           @default(0) @map("dependent_count")
  monthlyExpense     Decimal       @map("monthly_expense") @db.Decimal(15, 2)
  existingDebt       Decimal       @default(0) @map("existing_debt") @db.Decimal(15, 2)
  existingCoverage   Decimal       @default(0) @map("existing_coverage") @db.Decimal(15, 2)
  protectionDuration Int           @default(10) @map("protection_duration")
  inflationRate      Decimal       @default(5.0) @map("inflation_rate") @db.Decimal(5, 2)
  returnRate         Decimal       @default(7.0) @map("return_rate") @db.Decimal(5, 2)
  finalExpense       Decimal       @default(0) @db.Decimal(15, 2)
  coverageNeeded     Decimal       @map("coverage_needed") @db.Decimal(15, 2)
  recommendation     String?       @db.Text
  user               User          @relation(fields: [userId], references: [id])

  @@map("insurance_plans")
}

model GoalPlan {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  goalName      String   @map("goal_name")
  targetAmount  Decimal  @map("target_amount") @db.Decimal(15, 2)
  targetDate    DateTime @map("target_date")
  inflationRate Decimal  @default(5.0) @map("inflation_rate") @db.Decimal(5, 2)
  returnRate    Decimal  @default(6.0) @map("return_rate") @db.Decimal(5, 2)
  futureValue   Decimal  @map("future_value") @db.Decimal(15, 2)
  monthlySaving Decimal  @map("monthly_saving") @db.Decimal(15, 2)
  user          User     @relation(fields: [userId], references: [id])

  @@map("goal_plans")
}

// =========================================================
// EDUCATION MODULE & QUIZ
// =========================================================

model EducationCategory {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  description  String?           @db.VarChar(255)
  iconUrl      String            @map("icon_url")
  displayOrder Int               @default(0) @map("display_order")
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  modules EducationModule[]

  @@map("education_categories")
}

model EducationModule {
  id           String                @id @default(uuid())
  categoryId   String                @map("category_id")
  title        String
  slug         String                @unique
  thumbnailUrl String                @map("thumbnail_url")
  excerpt      String                @db.Text
  readingTime  Int                   @default(5) @map("reading_time")
  level        EducationLevel        @default(BEGINNER)
  points       Int                   @default(0)
  status       EducationModuleStatus @default(DRAFT)
  publishedAt  DateTime?             @map("published_at")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  category     EducationCategory     @relation(fields: [categoryId], references: [id])
  sections     ModuleSection[]
  userProgress UserEducationProgress[]
  quiz         Quiz?

  @@index([categoryId])
  @@index([status])
  @@index([slug])
  @@map("education_modules")
}

model ModuleSection {
  id              String          @id @default(uuid())
  moduleId        String          @map("module_id")
  sectionOrder    Int             @map("section_order")
  title           String?
  contentMarkdown String          @map("content_markdown") @db.Text
  
  // UBAH BAGIAN INI MENJADI ARRAY
  imageUrls       String[]        @map("image_urls")

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  module          EducationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progressLogs    UserEducationProgress[]

  @@index([moduleId])
  @@map("module_sections")
}

model UserEducationProgress {
  userId            String                  @map("user_id")
  moduleId          String                  @map("module_id")
  status            EducationProgressStatus @default(STARTED)
  lastReadSectionId String?                 @map("last_read_section_id")
  quizScore         Int?                    @map("quiz_score")
  quizAttempts      Int                     @default(0) @map("quiz_attempts")
  isPassed          Boolean                 @default(false) @map("is_passed")
  lastQuizDate      DateTime?               @map("last_quiz_date")
  completedAt       DateTime?               @map("completed_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  startedAt         DateTime?               @map("started_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  module          EducationModule @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  lastReadSection ModuleSection?  @relation(fields: [lastReadSectionId], references: [id])

  @@id([userId, moduleId])
  @@map("user_education_progress")
}

model Quiz {
  id           String   @id @default(uuid())
  moduleId     String   @unique @map("module_id")
  passingScore Int      @default(70) @map("passing_score")
  timeLimit    Int      @default(0) @map("time_limit")
  maxAttempts  Int      @default(3) @map("max_attempts")
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  module       EducationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    QuizQuestion[]

  @@map("quizzes")
}

model QuizQuestion {
  id           String           @id @default(uuid())
  quizId       String           @map("quiz_id")
  questionText String           @map("question_text") @db.Text
  type         QuizQuestionType @default(SINGLE_CHOICE)
  imageUrl     String?          @map("image_url")
  points       Int              @default(10)
  orderIndex   Int              @map("order_index")
  explanation  String?          @db.Text
  quiz         Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options      QuizOption[]

  @@index([quizId])
  @@map("quiz_questions")
}

model QuizOption {
  id         String       @id @default(uuid())
  questionId String       @map("question_id")
  optionText String       @map("option_text") @db.Text
  isCorrect  Boolean      @default(false) @map("is_correct")
  imageUrl   String?      @map("image_url")
  orderIndex Int          @default(0) @map("order_index")
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
  @@map("quiz_options")
}

model GoldPriceHistory {
  id           String   @id @default(uuid())
  buyPrice     Decimal  @map("buy_price") @db.Decimal(10, 2)
  sellPrice    Decimal  @map("sell_price") @db.Decimal(10, 2)
  openPrice    Decimal? @map("open_price") @db.Decimal(10, 2)
  changeAmount Decimal? @map("change_amount") @db.Decimal(10, 2)
  currency     String   @default("IDR") @map("currency")
  unit         String   @default("GRAM") @map("unit")
  source       String   @map("source")
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@index([fetchedAt])
  @@map("gold_price_histories")
}